{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ademanishproject1"
		},
		"LSAzureSql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LSAzureSql'"
		},
		"LS_AzureDataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_AzureDataLake'"
		},
		"LSAzureSql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adf-sql-srever.database.windows.net"
		},
		"LSAzureSql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "spotifydb"
		},
		"LSAzureSql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "manish-admin"
		},
		"LS_AzureDataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storagedeproject1.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ademanishproject1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LSAzureSql_password": {
						"value": "[parameters('LSAzureSql_password')]"
					},
					"LS_AzureDataLake_accountKey": {
						"value": "[parameters('LS_AzureDataLake_accountKey')]"
					},
					"LSAzureSql_properties_typeProperties_server": {
						"value": "[parameters('LSAzureSql_properties_typeProperties_server')]"
					},
					"LSAzureSql_properties_typeProperties_database": {
						"value": "[parameters('LSAzureSql_properties_typeProperties_database')]"
					},
					"LSAzureSql_properties_typeProperties_userName": {
						"value": "[parameters('LSAzureSql_properties_typeProperties_userName')]"
					},
					"LS_AzureDataLake_properties_typeProperties_url": {
						"value": "[parameters('LS_AzureDataLake_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}